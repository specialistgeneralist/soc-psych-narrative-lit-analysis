# API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model choices
OPENAI_EMBEDDING_MODEL_SMALL=text-embedding-3-small
OPENAI_EMBEDDING_MODEL_LARGE=text-embedding-3-large
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"            # used for synthesis/summarising tasks

# General settings
SEED=42

# File/column defaults
INPUT_TSV=data/input_example.csv        # tab separated values file
TEXT_COLUMN=text_normalised
ID_COLUMN=uid

# Output directories
OUTPUT_DIR=outputs
EMBEDDINGS_DIR=outputs/embeddings
PLOTS_DIR=outputs/plots
RESULTS_DIR=outputs/results
SUMMARIES_DIR=outputs/summaries
CACHE_DIR=outputs/cache
