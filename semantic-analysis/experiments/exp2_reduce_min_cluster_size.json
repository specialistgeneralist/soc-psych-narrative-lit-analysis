{
  "tag": "exp_2_reduce_min_cluster_size",
  "seed": 42,

  "trimap": {
    "n_inliers": 3,
    "n_outliers": 10,
    "n_random": 5,
    "metric": "euclidean"
  },

  "hdbscan": {
    "min_cluster_size": 2,
    "min_samples": 2,
    "pca_dim": 2,
    "metric": "manhattan",
    "selection_method": "leaf",
    "cluster_selection_epsilon": 0.0
  },

  "top_k_per_cluster": 3
}
